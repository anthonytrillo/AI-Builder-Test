# =============================================================================
# Environment Variables
# Copy this file to `.env.local` and fill in the values for local development.
# Never commit `.env.local` or any file containing secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public (client-side) — exposed to the browser via NEXT_PUBLIC_ prefix
# Safe to reference in Client Components and browser code.
# -----------------------------------------------------------------------------

# Base URL of the application (used for metadata, OG tags, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application display name
NEXT_PUBLIC_APP_NAME=AI Builder

# -----------------------------------------------------------------------------
# Private (server-side only) — never prefix with NEXT_PUBLIC_
# Only accessible in Server Components, Route Handlers, and Server Actions.
# -----------------------------------------------------------------------------

# PostgreSQL / MySQL / etc. connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Secret key for signing tokens, webhooks, or internal API calls
# API_SECRET_KEY=your-secret-key-here
